+import io
+import json
+import struct
+import zlib
+from dataclasses import asdict
+
+import pytest
+
+from cosmos_predict1.tokenizer.progressive.protocol import (
+    PACKET,
+    SESSION,
+    Packet,
+    PrefixReceiver,
+    Session,
+)
+
+
+def fresh():
+    s = Session("m", "a" * 64, "b" * 64, 1920, 1080, 1920, 1088)
+    return PrefixReceiver(
+        s, model_id="m", checkpoint_sha256="a" * 64, config_sha256="b" * 64
+    )
+
+
+def test_rejects_late_skipped_unfinished_and_malformed_packets():
+    r = fresh()
+    with pytest.raises(ValueError, match="order"):
+        r.append_tokens(Packet(1, 1, 4, 0, (0,) * 256))
+    r.append_tokens(Packet(0, 0, 1, 0, (0,) * 128))
+    with pytest.raises(ValueError, match="base"):
+        r.append_tokens(Packet(1, 1, 4, 0, (0,) * 256))
+    r.append_tokens(Packet(0, 0, 1, 128, (0,) * 128, block_end=True))
+    r.append_tokens(Packet(1, 1, 4, 0, (0,) * 256))
+    with pytest.raises(ValueError, match="late"):
+        r.append_tokens(Packet(0, 0, 1, 256, (0,) * 256))
+    with pytest.raises(ValueError, match="EOS"):
+        r.read_packet(io.BytesIO())
+    for data in (b"C", b"CHPB", Packet(0, 0, 1, 0, (0,) * 256).to_bytes()[:-1]):
+        with pytest.raises(ValueError):
+            Packet.read(io.BytesIO(data))
+    for field in (
+        dict(bits_per_token=13),
+        dict(fsq_levels=(8,) * 6),
+        dict(padded_height=1080),
+        dict(checkpoint_sha256="x" * 64),
+    ):
+        args = dict(
+            model_id="m",
+            checkpoint_sha256="a" * 64,
+            config_sha256="b" * 64,
+            width=1920,
+            height=1080,
+            padded_width=1920,
+            padded_height=1088,
+        )
+        args.update(field)
+        with pytest.raises(ValueError):
+            Session(**args)
+
+
+def test_explicit_eos_and_actual_tail_count():
+    r = fresh()
+    r.append_tokens(Packet(0, 0, 1, 0, (0,) * 256, block_end=True))
+    with pytest.raises(ValueError, match="EOS"):
+        r.append_tokens(Packet(1, 1, 3, 0, (0,) * 256))
+    r.append_tokens(Packet(1, 1, 3, 0, (0,) * 256, True))
+    assert r.finished and r.metadata[-1] == (1, 3)
+    assert r.read_packet(io.BytesIO()) is None
+
+
+def test_wire_out_of_range_ids_even_with_valid_crc_are_rejected():
+    p = Packet(0, 0, 1, 0, (0,)).to_bytes()
+    body = p[: PACKET.size] + struct.pack(">H", 64000)
+    with pytest.raises(ValueError, match="FSQ"):
+        Packet.read(io.BytesIO(body + struct.pack(">I", zlib.crc32(body))))
+
+
+def test_rejected_packet_does_not_mutate_receiver_state():
+    r = fresh()
+    r.append_tokens(Packet(0, 0, 1, 0, (0,) * 256, block_end=True))
+    before = (r.actual_bytes, list(map(list, r.blocks)), list(r.metadata))
+    with pytest.raises(ValueError):
+        r.append_tokens(Packet(1, 1, 4, 0, (0,) * 4096))
+    assert (r.actual_bytes, r.blocks, r.metadata) == before
+
+
+@pytest.mark.parametrize(
+    "block,start,count,tail",
+    [(0, 0, 1, True), (1, 1, 4, True), (-1, 0, 1, False), (0, -1, 1, False)],
+)
+def test_invalid_tail_or_timestamp_rejected_before_serialization(
+    block, start, count, tail
+):
+    with pytest.raises(ValueError):
+        Packet(block, start, count, 0, (0,) * 256, tail=tail)
+
+
+def test_frame_alignment_errors_do_not_create_receiver_blocks():
+    r = fresh()
+    for packet in (Packet(0, 1, 1, 0, (0,) * 256), Packet(0, 0, 4, 0, (0,) * 256)):
+        with pytest.raises(ValueError, match="frame"):
+            r.append_tokens(packet)
+        assert not r.blocks
+
+
+def test_receiver_counts_actual_session_bytes_including_json_whitespace():
+    metadata = asdict(fresh().session)
+    payload = json.dumps(metadata, indent=2).encode()
+    body = SESSION.pack(b"CHP2", len(payload)) + payload
+    session_wire = body + struct.pack(">I", zlib.crc32(body))
+    parsed = Session.read(io.BytesIO(session_wire))
+    r = PrefixReceiver(
+        parsed, model_id="m", checkpoint_sha256="a" * 64, config_sha256="b" * 64
+    )
+    packet = Packet(0, 0, 1, 0, (0,) * 256, eos=True)
+    r.read_packet(io.BytesIO(packet.to_bytes()))
+    assert r.actual_bytes == len(session_wire) + len(packet.to_bytes())
