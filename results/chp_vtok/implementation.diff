index 0000000..095274b
--- /dev/null
+++ b/cosmos_predict1/tokenizer/progressive/latent_decoder.py
@@ -0,0 +1,94 @@
+"""Prefix-conditioned learned spatial queries with bounded slot neighborhoods.
+
+Only IDs actually received are converted to codes. The fixed slot ordering is
+regenerated from resolution metadata. Missing is a separate learned embedding;
+ID zero is never a sentinel. Residual references use these same decoded codes.
+"""
+
+from functools import lru_cache
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from .anchors import anchors
+
+
+@lru_cache(maxsize=48)
+def neighbor_map(height, width, count, order, neighbors):
+    _, positions = anchors(height, width, count, order)
+    y = (torch.arange(height) + 0.5) / height
+    x = (torch.arange(width) + 0.5) / width
+    grid = torch.stack(torch.meshgrid(y, x, indexing="ij"), -1).reshape(-1, 2)
+    # Stable sort defines deterministic tie-break by slot ID, on CPU in float64.
+    result = []
+    for tile in grid.double().split(256):
+        distances = (tile[:, None] - positions.double()[None]).square().sum(-1)
+        result.append(
+            torch.argsort(distances, dim=-1, stable=True)[:, : min(count, neighbors)]
+        )
+    return torch.cat(result), grid
+
+
+class PrefixLatentDecoder(nn.Module):
+    def __init__(self, channels, count, config):
+        super().__init__()
+        self.count, self.config = count, config
+        d = config.hidden_dim
+        self.slot = nn.Parameter(torch.randn(count, d) * 0.02)
+        self.missing = nn.Parameter(torch.randn(d) * 0.02)
+        self.code = nn.Linear(6, d)
+        self.query = nn.Linear(2, d)
+        self.key = nn.Linear(d, d)
+        self.value = nn.Linear(d, d)
+        self.output = nn.Linear(d, channels)
+        self.refine = nn.Sequential(
+            nn.Conv2d(channels, channels, 3, padding=1, groups=channels),
+            nn.SiLU(),
+            nn.Conv2d(channels, channels, 1),
+        )
+
+    def forward(self, codes, shape):
+        b, received, _ = codes.shape
+        if received > self.count:
+            raise ValueError("prefix exceeds group length")
+        h, w = shape
+        indices, grid = neighbor_map(
+            h, w, self.count, self.config.anchor_order, self.config.decoder_neighbors
+        )
+        indices, grid = (
+            indices.to(codes.device),
+            grid.to(device=codes.device, dtype=self.slot.dtype),
+        )
+        visible = torch.arange(self.count, device=codes.device) < received
+        encoded = self.code(codes.to(self.slot.dtype))
+        padded = F.pad(encoded, (0, 0, 0, self.count - received))
+        slots = self.slot[None] + torch.where(
+            visible[None, :, None], padded, self.missing[None, None]
+        )
+        # Bounded neighbors, evaluated in tiles. The learned missing representation is
+        # intentionally retained; no unreceived integer or feature enters this graph.
+        output = []
+        d, heads = self.config.hidden_dim, self.config.heads
+        for idx, xy in zip(indices.split(512), grid.split(512)):
+            n = idx.shape[0]
+            features = slots[:, idx]
+            q = (
+                self.query(xy)[None]
+                .expand(b, -1, -1)
+                .reshape(b * n, heads, 1, d // heads)
+            )
+
+            def project(module):
+                return (
+                    module(features)
+                    .reshape(b * n, -1, heads, d // heads)
+                    .transpose(1, 2)
+                )
+
+            out = F.scaled_dot_product_attention(
+                q, project(self.key), project(self.value), dropout_p=0.0
+            )
+            output.append(self.output(out.reshape(b, n, d)))
+        dense = torch.cat(output, 1).transpose(1, 2).reshape(b, -1, h, w)
+        return dense + self.refine(dense)
diff --git a/cosmos_predict1/tokenizer/progressive/model.py b/cosmos_predict1/tokenizer/progressive/model.py
new file mode 100644
index 0000000..7d59da7
--- /dev/null
+++ b/cosmos_predict1/tokenizer/progressive/model.py
@@ -0,0 +1,329 @@
+"""CHP-VTok over the official InfoTok causal convolutional backbone.
+
+The pretrained ViT and 2D bottleneck are deliberately not on the new model's
+path. Their replacement is a separately trained 1D bottleneck, not an equivalent
+checkpoint conversion. No dense latent is serialized or required by a receiver.
+"""
+
+import hashlib
+from collections import namedtuple
+from dataclasses import dataclass
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+from torch.utils.checkpoint import checkpoint
+
+from cosmos_predict1.tokenizer.networks.configs import ours_discrete_video_4x8x8_256p_88
+from cosmos_predict1.tokenizer.networks.ours_discrete_video import (
+    OursDiscreteVideoTokenizer,
+)
+
+from .causal_state import install_dispatch
+from .config import CHPConfig
+from .feature_pyramid import feature_pyramid
+from .latent_decoder import PrefixLatentDecoder
+from .quantizer import make_fsq, quantize, validate_ids
+from .slot_compressor import SlotCompressor
+
+Evaluation = namedtuple(
+    "CHPEvaluation",
+    "reconstructions quant_loss latent allocated_ratios token_ids latent_loss",
+)
+
+
+def file_sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+@dataclass(frozen=True)
+class Geometry:
+    height: int
+    width: int
+    padded_height: int
+    padded_width: int
+
+    def __post_init__(self):
+        if min(self.height, self.width) < 1:
+            raise ValueError("invalid dimensions")
+        if (
+            self.padded_height != (self.height + 31) // 32 * 32
+            or self.padded_width != (self.width + 31) // 32 * 32
+        ):
+            raise ValueError("CHP requires the canonical padding to multiples of 32")
+
+    @classmethod
+    def from_video(cls, x):
+        h, w = x.shape[-2:]
+        return cls(h, w, (h + 31) // 32 * 32, (w + 31) // 32 * 32)
+
+    @property
+    def latent_shape(self):
+        return self.padded_height // 8, self.padded_width // 8
+
+    def pad(self, x):
+        if tuple(x.shape[-2:]) != (self.height, self.width):
+            raise ValueError("geometry changed inside a session")
+        return F.pad(
+            x, (0, self.padded_width - self.width, 0, self.padded_height - self.height)
+        )
+
+    def crop(self, x):
+        return x[..., : self.height, : self.width]
+
+
+def official_backbone(checkpoint=None, debug=False):
+    config = dict(ours_discrete_video_4x8x8_256p_88)
+    if debug:
+        config.update(
+            channels=8,
+            channels_mult=[1, 2, 2],
+            num_res_blocks=1,
+            z_channels=16,
+            use_vit=False,
+            attn_resolutions=[],
+        )
+    model = OursDiscreteVideoTokenizer(**config)
+    if checkpoint is not None:
+        raw = torch.load(checkpoint, map_location="cpu", weights_only=False)
+        raw = raw.get("model", raw)
+        weights = {
+            k.removeprefix("network."): v
+            for k, v in raw.items()
+            if k.startswith("network.")
+        }
+        result = model.load_state_dict(weights, strict=False)
+        # Official checkpoints omit fixed patch/FSQ buffers, but no learned weight may be absent.
+        missing_parameters = set(result.missing_keys) & set(
+            dict(model.named_parameters())
+        )
+        if missing_parameters or result.unexpected_keys:
+            raise ValueError(
+                f"checkpoint mismatch: missing={missing_parameters}, unexpected={result.unexpected_keys}"
+            )
+    return model
+
+
+class CHPVTokenizer(nn.Module):
+    def __init__(self, config=None):
+        super().__init__()
+        self.config = (
+            config if isinstance(config, CHPConfig) else CHPConfig(**(config or {}))
+        )
+        cfg = self.config
+        original = official_backbone(cfg.backbone_checkpoint, cfg.debug_backbone)
+        # Reuse objects and their weights, do not copy the implementations or keep unused ViTs.
+        self.encoder, self.decoder = original.encoder, original.decoder
+        self.channels = 16 if cfg.debug_backbone else 256
+        self.quantizer = make_fsq()
+        counts = (
+            [cfg.base_tokens, cfg.structure_tokens, cfg.kmax - 1024]
+            if cfg.multiscale
+            else [cfg.kmax]
+        )
+        self.strides = [32, 16, 8] if cfg.multiscale else [8]
+        self.compressors = nn.ModuleList(
+            [SlotCompressor(self.channels, k, cfg) for k in counts]
+        )
+        self.latent_decoders = nn.ModuleList(
+            [PrefixLatentDecoder(self.channels, k, cfg) for k in counts]
+        )
+        self.reference_projection = nn.Conv2d(
+            self.channels, self.channels, 1, bias=False
+        )
+        self.display_projection = nn.Conv2d(self.channels, self.channels, 1, bias=False)
+        nn.init.zeros_(self.reference_projection.weight)
+        nn.init.zeros_(self.display_projection.weight)
+        if cfg.freeze_backbone:
+            self.encoder.requires_grad_(False)
+            self.decoder.requires_grad_(False)
+        install_dispatch(self.encoder, window=cfg.spatial_window)
+        install_dispatch(
+            self.decoder,
+            window=cfg.spatial_window,
+            checkpoint_blocks=cfg.checkpoint_decoder,
+        )
+
+    def train(self, mode=True):
+        super().train(mode)
+        if self.config.freeze_backbone:
+            for name in ("encoder", "decoder"):
+                module = self._modules.get(name)
+                if module is not None:
+                    module.eval()
+        return self
+
+    def backbone_encode(self, x):
+        # Frozen encoder needs no gradients; frozen decoder MUST retain latent gradients.
+        if self.config.freeze_backbone:
+            with torch.no_grad():
+                return self.encoder(x)
+        return self.encoder(x)
+
+    def compress_features(self, f8, return_references=False):
+        pyramid = feature_pyramid(f8)
+        codes_all, ids_all, references = [], [], []
+        reconstruction = torch.zeros_like(f8)
+        losses = []
+        for stride, compressor, decoder in zip(
+            self.strides, self.compressors, self.latent_decoders
+        ):
+            target = pyramid[stride]
+            # Quantized and receiver-recoverable previous groups only. No private
+            # unquantized base features are used to predict a residual reference.
+            reference = F.adaptive_avg_pool2d(reconstruction, target.shape[-2:])
+            ids, codes, loss = quantize(self.quantizer, compressor(target - reference))
+            delta = decoder(codes, target.shape[-2:])
+            reconstruction = reconstruction + F.interpolate(
+                delta, size=f8.shape[-2:], mode="bilinear", align_corners=False
+            )
+            ids_all.append(ids)
+            codes_all.append(codes)
+            losses.append(loss)
+            references.append(reconstruction)
+        result = torch.cat(ids_all, 1), torch.cat(codes_all, 1), sum(losses)
+        return (*result, references) if return_references else result
+
+    def dense_from_codes(self, codes, shape):
+        b, received, _ = codes.shape
+        h, w = shape
+        dense = codes.new_zeros(b, self.channels, h, w).to(
+            self.latent_decoders[0].slot.dtype
+        )
+        offset = 0
+        for stride, decoder in zip(self.strides, self.latent_decoders):
+            group = codes[:, offset : min(received, offset + decoder.count)]
+            if group.shape[1]:
+                divisor = stride // 8
+                delta = decoder(
+                    group, ((h + divisor - 1) // divisor, (w + divisor - 1) // divisor)
+                )
+                dense = dense + F.interpolate(
+                    delta, size=(h, w), mode="bilinear", align_corners=False
+                )
+            offset += decoder.count
+        return dense
+
+    def dense_from_ids(self, ids, shape):
+        validate_ids(ids)
+        if ids.ndim != 2 or not 1 <= ids.shape[1] <= self.config.kmax:
+            raise ValueError("expected a nonempty [B,K] prefix")
+        codes = self.quantizer.indices_to_codes(ids.to(torch.int32))
+        return self.dense_from_codes(codes, shape)
+
+    def condition(self, dense, reference=None, display=None):
+        if reference is not None:
+            dense = dense + self.reference_projection(reference)
+        if display is not None:
+            dense = dense + self.display_projection(display)
+        return dense
+
+    def encode(self, video):
+        if video.ndim != 5 or video.shape[1] != 3 or (video.shape[2] - 1) % 4:
+            raise ValueError(
+                "encode expects [B,3,1+4n,H,W]; use stream API for EOS tails"
+            )
+        geometry = Geometry.from_video(video)
+        features = self.backbone_encode(geometry.pad(video))
+        ids = [self.compress_features(frame)[0] for frame in features.unbind(2)]
+        return torch.stack(ids, 1), geometry
+
+    def decode(self, tokens, geometry, budgets=None):
+        if tokens.ndim != 3:
+            raise ValueError("tokens must be [B,blocks,K] including bootstrap")
+        budgets = budgets or [tokens.shape[-1]] * tokens.shape[1]
+        if len(budgets) != tokens.shape[1] or any(
+            k < 256 or k > tokens.shape[-1] for k in budgets
+        ):
+            raise ValueError("each committed block requires a received base prefix")
+        reference, display, dense, bases = None, None, [], []
+        for t, k in enumerate(budgets):
+            prefix = tokens[:, t, :k]
+            current = self.condition(
+                self.dense_from_ids(prefix, geometry.latent_shape), reference, display
+            )
+            reference = self.condition(
+                self.dense_from_ids(prefix[:, :256], geometry.latent_shape), reference
+            )
+            display = current
+            dense.append(current)
+            bases.append(reference)
+        return self.decode_latent_sequence(dense, bases, geometry)
+
+    def decode_latent_sequence(self, dense, bases, geometry):
+        # Reference semantics: historical backbone activations derive only from
+        # base IDs. This full causal reference implementation repeats legal
+        # history; the stream API instead reuses exactly those base caches.
+        frames = []
+        for t, current in enumerate(dense):
+            latent = torch.stack(bases[:t] + [current], 2)
+            if (
+                self.config.checkpoint_decoder
+                and torch.is_grad_enabled()
+                and latent.requires_grad
+            ):
+                # The repeated full-prefix reference graph otherwise retains
+                # multiple high-resolution decoder graphs simultaneously.
+                frame = checkpoint(
+                    self._decode_current, latent, geometry, t, use_reentrant=False
+                )
+            else:
+                frame = self._decode_current(latent, geometry, t)
+            frames.append(frame)
+        return torch.cat(frames, 2)
+
+    def _decode_current(self, latent, geometry, block):
+        decoded = geometry.crop(self.decoder(latent))
+        return decoded if block == 0 else decoded[:, :, -4:]
+
+    def forward(self, video, budgets=None):
+        if (video.shape[2] - 1) % 4:
+            raise ValueError("training requires bootstrap + complete four-frame blocks")
+        geometry = Geometry.from_video(video)
+        features = self.backbone_encode(geometry.pad(video))
+        steps = features.shape[2]
+        if budgets is None:
+            # Independently sample each historical block, not only the last block.
+            budgets = [
+                self.config.budgets[
+                    int(torch.randint(len(self.config.budgets), ()).item())
+                ]
+                for _ in range(steps)
+            ]
+        if len(budgets) != steps or any(
+            k < 256 or k > self.config.kmax for k in budgets
+        ):
+            raise ValueError("invalid per-block budgets")
+        ids_all, dense_all, base_all, quant_losses = [], [], [], []
+        reference, display = None, None
+        for frame, k in zip(features.unbind(2), budgets):
+            ids, codes, quant_loss = self.compress_features(frame)
+            dense = self.condition(
+                self.dense_from_codes(codes[:, :k], geometry.latent_shape),
+                reference,
+                display,
+            )
+            reference = self.condition(
+                self.dense_from_codes(codes[:, :256], geometry.latent_shape), reference
+            )
+            display = dense
+            dense_all.append(dense)
+            base_all.append(reference)
+            ids_all.append(ids)
+            quant_losses.append(quant_loss)
+        dense = torch.stack(dense_all, 2)
+        # No no_grad / detach here: frozen RGB decoder backpropagates to new modules.
+        reconstruction = self.decode_latent_sequence(dense_all, base_all, geometry)
+        result = dict(
+            reconstructions=reconstruction,
+            quant_loss=sum(quant_losses),
+            latent=dense,
+            allocated_ratios=video.new_tensor(budgets)[None] / self.config.kmax,
+            token_ids=torch.stack(ids_all, 1),
+            latent_loss=F.mse_loss(dense.float(), features.float()),
+        )
+        return result if self.training else Evaluation(**result)
diff --git a/cosmos_predict1/tokenizer/progressive/protocol.py b/cosmos_predict1/tokenizer/progressive/protocol.py
new file mode 100644
index 0000000..6caeec0
--- /dev/null
+++ b/cosmos_predict1/tokenizer/progressive/protocol.py
@@ -0,0 +1,284 @@
+"""CHP2 session / CHPB packets, network-endian uint16 IDs, CRC32, explicit EOS.
+
+All bytes count, including the bootstrap, session, and every incremental header.
+The v2 transport is ordered within and across blocks. Each final block prefix
+explicitly closes the block, without looking at a future packet.
+"""
+
+import json
+import struct
+import zlib
+from dataclasses import asdict, dataclass
+
+import numpy as np
+import torch
+
+from .config import CODEBOOK_SIZE, FSQ_LEVELS
+from .model import Geometry
+
+SESSION = struct.Struct(">4sI")
+PACKET = struct.Struct(">4sIQHHHIB")
+CRC = struct.Struct(">I")
+MAX_HEADER = 16384
+
+
+@dataclass(frozen=True)
+class Session:
+    model_id: str
+    checkpoint_sha256: str
+    config_sha256: str
+    width: int
+    height: int
+    padded_width: int
+    padded_height: int
+    kmax: int = 2048
+    fps_num: int = 30
+    fps_den: int = 1
+    protocol_version: int = 2
+    temporal_block_size: int = 4
+    bootstrap_mode: str = "one-discrete-frame"
+    quantizer_type: str = "FSQ"
+    fsq_levels: tuple[int, ...] = FSQ_LEVELS
+    bits_per_token: int = 16
+    timebase_num: int = 1
+    timebase_den: int = 30
+
+    def __post_init__(self):
+        object.__setattr__(self, "fsq_levels", tuple(self.fsq_levels))
+        Geometry(self.height, self.width, self.padded_height, self.padded_width)
+        self._validate_protocol()
+        self._validate_timing()
+        self._validate_identity()
+
+    def _validate_protocol(self):
+        settings = (
+            self.protocol_version,
+            self.temporal_block_size,
+            self.bits_per_token,
+            self.fsq_levels,
+            self.quantizer_type,
+            self.bootstrap_mode,
+        )
+        if settings != (2, 4, 16, FSQ_LEVELS, "FSQ", "one-discrete-frame"):
+            raise ValueError("unsupported CHP session")
+        if self.kmax not in (2048, 4096, 8192):
+            raise ValueError("unsupported Kmax")
+
+    def _validate_timing(self):
+        if min(self.fps_num, self.fps_den, self.timebase_num, self.timebase_den) <= 0:
+            raise ValueError("invalid timing")
+        if self.timebase_num * self.fps_num != self.timebase_den * self.fps_den:
+            raise ValueError("v2 timebase must be inverse fps")
+
+    def _validate_identity(self):
+        for sha in (self.checkpoint_sha256, self.config_sha256):
+            if len(sha) != 64 or any(c not in "0123456789abcdef" for c in sha):
+                raise ValueError("invalid SHA256")
+        if not self.model_id or len(self.model_id) > 128:
+            raise ValueError("invalid model ID")
+
+    @property
+    def geometry(self):
+        return Geometry(self.height, self.width, self.padded_height, self.padded_width)
+
+    def to_bytes(self):
+        payload = json.dumps(
+            asdict(self), sort_keys=True, separators=(",", ":")
+        ).encode()
+        header = SESSION.pack(b"CHP2", len(payload)) + payload
+        return header + CRC.pack(zlib.crc32(header))
+
+    @property
+    def received_bytes(self):
+        # A legal peer may use a different JSON layout. Byte accounting must
+        # preserve its received representation, not reserialize a shorter one.
+        return getattr(self, "_received_bytes", len(self.to_bytes()))
+
+    @classmethod
+    def read(cls, source):
+        header = exact(source, SESSION.size)
+        magic, size = SESSION.unpack(header)
+        if magic != b"CHP2" or size > MAX_HEADER:
+            raise ValueError("invalid CHP2 header")
+        payload = exact(source, size)
+        if CRC.unpack(exact(source, CRC.size))[0] != zlib.crc32(header + payload):
+            raise ValueError("session CRC32 mismatch")
+        try:
+            session = cls(**json.loads(payload))
+        except (TypeError, json.JSONDecodeError) as e:
+            raise ValueError("invalid session metadata") from e
+        object.__setattr__(session, "_received_bytes", SESSION.size + size + CRC.size)
+        return session
+
+
+def exact(source, count):
+    data = source.read(count)
+    if len(data) != count:
+        raise ValueError("truncated CHP stream")
+    return data
+
+
+@dataclass(frozen=True)
+class Packet:
+    block_id: int
+    frame_start: int
+    frame_count: int
+    prefix_offset: int
+    ids: tuple[int, ...]
+    eos: bool = False
+    block_end: bool = False
+    tail: bool = False
+
+    def __post_init__(self):
+        if self.eos:
+            object.__setattr__(self, "block_end", True)
+        self._validate_frame_flags()
+        self._validate_counts()
+        if any(
+            not isinstance(i, (int, np.integer)) or not 0 <= i < CODEBOOK_SIZE
+            for i in self.ids
+        ):
+            raise ValueError("invalid FSQ symbol")
+
+    def _validate_frame_flags(self):
+        if self.tail and (self.block_id == 0 or self.frame_count == 4):
+            raise ValueError("tail flag requires a partial final temporal block")
+        if not 0 <= self.block_id < 2**32 or not 0 <= self.frame_start < 2**64:
+            raise ValueError("invalid timestamp/block")
+
+    def _validate_counts(self):
+        if not 1 <= self.frame_count <= 4:
+            raise ValueError("invalid frame count")
+        if not 0 <= self.prefix_offset < 8192 or not 1 <= len(self.ids) <= 8192:
+            raise ValueError("invalid packet counts")
+
+    def to_bytes(self):
+        payload = np.asarray(self.ids, dtype=">u2").tobytes()
+        header = PACKET.pack(
+            b"CHPB",
+            self.block_id,
+            self.frame_start,
+            self.frame_count,
+            self.prefix_offset,
+            len(self.ids),
+            len(payload),
+            int(self.eos) | (int(self.block_end) << 1) | (int(self.tail) << 2),
+        )
+        return header + payload + CRC.pack(zlib.crc32(header + payload))
+
+    @classmethod
+    def read(cls, source):
+        header = source.read(PACKET.size)
+        if not header:
+            return None
+        if len(header) != PACKET.size:
+            raise ValueError("truncated packet header")
+        magic, block, start, count, offset, size, length, flags = PACKET.unpack(header)
+        if (
+            magic != b"CHPB"
+            or size > 8192
+            or length != size * 2
+            or flags not in range(8)
+        ):
+            raise ValueError("invalid packet header")
+        payload = exact(source, length)
+        if CRC.unpack(exact(source, CRC.size))[0] != zlib.crc32(header + payload):
+            raise ValueError("packet CRC32 mismatch")
+        return cls(
+            block,
+            start,
+            count,
+            offset,
+            tuple(np.frombuffer(payload, dtype=">u2").tolist()),
+            bool(flags & 1),
+            bool(flags & 2),
+            bool(flags & 4),
+        )
+
+
+class PrefixReceiver:
+    def __init__(self, session, *, model_id, checkpoint_sha256, config_sha256):
+        if (session.model_id, session.checkpoint_sha256, session.config_sha256) != (
+            model_id,
+            checkpoint_sha256,
+            config_sha256,
+        ):
+            raise ValueError("model/checkpoint/config identity mismatch")
+        self.session = session
+        self.blocks, self.metadata = [], []
+        self.actual_bytes = session.received_bytes
+        self.finished = False
+        self.block_closed = False
+
+    def _validate_position(self, packet):
+        if self.finished:
+            raise ValueError("tokens after EOS")
+        if packet.block_id > len(self.blocks) or packet.block_id < len(self.blocks) - 1:
+            raise ValueError("out-of-order or late block")
+        self._validate_prefix_count(packet)
+        self._validate_frame_metadata(packet)
+
+    def _validate_prefix_count(self, packet):
+        end = packet.prefix_offset + len(packet.ids)
+        if end > self.session.kmax:
+            raise ValueError("prefix exceeds Kmax")
+        if packet.block_end and end < 256:
+            raise ValueError("block end/EOS requires a base prefix")
+        if packet.tail and packet.block_end and not packet.eos:
+            raise ValueError("a partial tail must finish with explicit EOS")
+
+    def _validate_new_block(self, packet):
+        if self.blocks and len(self.blocks[-1]) < 256:
+            raise ValueError("cannot advance without base prefix")
+        if self.blocks and not self.block_closed:
+            raise ValueError("previous block must be explicitly closed")
+        if packet.prefix_offset != 0:
+            raise ValueError("missing necessary prefix")
+
+    @staticmethod
+    def _validate_frame_metadata(packet):
+        expected = 0 if packet.block_id == 0 else 1 + 4 * (packet.block_id - 1)
+        if packet.frame_start != expected:
+            raise ValueError("frame alignment error")
+        if packet.block_id == 0 and packet.frame_count != 1:
+            raise ValueError("bootstrap frame count error")
+        if (
+            packet.block_id > 0
+            and packet.frame_count != 4
+            and not (packet.eos or packet.tail)
+        ):
+            raise ValueError("partial tail needs EOS")
+
+    def _validate_existing_block(self, packet):
+        if self.block_closed:
+            raise ValueError("block already closed")
+        if self.metadata[packet.block_id] != (packet.frame_start, packet.frame_count):
+            raise ValueError("block geometry changed")
+        if packet.prefix_offset != len(self.blocks[packet.block_id]):
+            raise ValueError("duplicate or non-contiguous prefix offset")
+
+    def append_tokens(self, packet):
+        self._validate_position(packet)
+        new_block = packet.block_id == len(self.blocks)
+        if new_block:
+            self._validate_new_block(packet)
+        else:
+            self._validate_existing_block(packet)
+        # All validation precedes mutation, including rejected first packets.
+        if new_block:
+            self.blocks.append([])
+            self.metadata.append((packet.frame_start, packet.frame_count))
+        self.blocks[packet.block_id].extend(packet.ids)
+        self.actual_bytes += len(packet.to_bytes())
+        self.finished = packet.eos
+        self.block_closed = packet.block_end
+        return torch.tensor([self.blocks[packet.block_id]], dtype=torch.int32)
+
+    def read_packet(self, source):
+        packet = Packet.read(source)
+        if packet is None:
+            if not self.finished:
+                raise ValueError("missing explicit EOS")
+            return None
+        self.append_tokens(packet)
+        return packet
diff --git a/cosmos_predict1/tokenizer/progressive/quantizer.py b/cosmos_predict1/tokenizer/progressive/quantizer.py
new file mode 100644
index 0000000..5f361da
--- /dev/null
+++ b/cosmos_predict1/tokenizer/progressive/quantizer.py
@@ -0,0 +1,27 @@
+"""The upstream FSQ, with exact integer validation and 1D shapes."""
+
+import torch
+
+from cosmos_predict1.tokenizer.modules.quantizers import FSQuantizer
+
+from .config import CODEBOOK_SIZE, FSQ_LEVELS
+
+
+def validate_ids(ids):
+    if ids.dtype not in (torch.int16, torch.int32, torch.int64, torch.uint16):
+        raise ValueError("tokens must be integer IDs")
+    if ids.numel() and (
+        ids.to(torch.int64).min() < 0 or ids.to(torch.int64).max() >= CODEBOOK_SIZE
+    ):
+        raise ValueError("FSQ ID outside [0,64000)")
+
+
+def make_fsq():
+    # Float32 prevents a non-power-of-two code spacing being rounded before indexing.
+    return FSQuantizer(levels=list(FSQ_LEVELS), dtype=torch.float32)
+
+
+def quantize(fsq, values):
+    with torch.autocast(values.device.type, enabled=False):
+        ids, codes, loss = fsq(values.float())
+    return ids, codes, loss.mean()
diff --git a/cosmos_predict1/tokenizer/progressive/slot_compressor.py b/cosmos_predict1/tokenizer/progressive/slot_compressor.py
new file mode 100644
index 0000000..e841011
--- /dev/null
+++ b/cosmos_predict1/tokenizer/progressive/slot_compressor.py
@@ -0,0 +1,63 @@
+"""Fixed learned 1D queries attend only to bounded neighborhoods at shared anchors."""
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+from .anchors import anchors
+
+
+class SlotCompressor(nn.Module):
+    def __init__(self, channels, count, config):
+        super().__init__()
+        self.count, self.config = count, config
+        d = config.hidden_dim
+        self.query = nn.Parameter(torch.randn(count, d) * 0.02)
+        self.position = nn.Linear(2, d)
+        self.key = nn.Linear(channels, d)
+        self.value = nn.Linear(channels, d)
+        self.norm = nn.LayerNorm(d)
+        self.to_code = nn.Linear(d, 6)
+
+    def forward(self, features):
+        b, c, h, w = features.shape
+        coords, positions = anchors(
+            h, w, self.count, self.config.anchor_order, features.device
+        )
+        radius = self.config.local_radius
+        delta = torch.arange(-radius, radius + 1, device=features.device)
+        offsets = torch.stack(torch.meshgrid(delta, delta, indexing="ij"), -1).reshape(
+            -1, 2
+        )
+        indices = coords[:, None] + offsets[None]
+        valid = (
+            (indices[..., 0] >= 0)
+            & (indices[..., 0] < h)
+            & (indices[..., 1] >= 0)
+            & (indices[..., 1] < w)
+        )
+        flat = indices[..., 0].clamp(0, h - 1) * w + indices[..., 1].clamp(0, w - 1)
+        patches = features.flatten(2).transpose(1, 2)[:, flat]
+        d, heads = self.config.hidden_dim, self.config.heads
+        q = (self.query + self.position(positions.to(self.query.dtype)))[None].expand(
+            b, -1, -1
+        )
+        q = q.reshape(b * self.count, heads, 1, d // heads)
+
+        def project(module):
+            return (
+                module(patches)
+                .reshape(b * self.count, -1, heads, d // heads)
+                .transpose(1, 2)
+            )
+
+        allowed = (
+            valid[None, :, None, None]
+            .expand(b, -1, 1, 1, -1)
+            .reshape(b * self.count, 1, 1, -1)
+        )
+        out = F.scaled_dot_product_attention(
+            q, project(self.key), project(self.value), attn_mask=allowed, dropout_p=0.0
+        )
+        out = out.reshape(b, self.count, d)
+        return self.to_code(self.norm(out + self.query[None]))
